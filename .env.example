# Product Compose settings. Copy this file to .env before installation.
MASTERHOST_PORT=8088
MASTERHOST_DB_USER=masterhost
MASTERHOST_DB_PASSWORD=replace-with-a-long-random-password
MASTERHOST_DB_NAME=masterhost
MASTERHOST_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Direct development settings.
DATABASE_URL=postgresql://masterhost:masterhost@localhost:5432/masterhost
PORT=8080
