    "description": "Three Survival and Rebuilding Frames for Dustroad Convoy, Seed Vault, Last Grid. Three complete rebuilding campaigns: convoy passage, shared seed inheritance and heat for omitted households.",
    "provides": [
      "world:post-apocalypse"
    ],
    "requires": [
      "setting:post-apocalypse"
    ],
    "conflicts": [],
    "parameters": {},
    "patches": [
      {
        "op": "set",
        "path": "/content/templates/waste.deep.kit.dustroad-convoy",
        "value": {
          "kind": "campaign-kit",
          "values": {
            "name": {
              "value": "Dustroad: A Road Kept Open"
            },
            "kitId": {
              "value": "kit.dustroad-convoy"
            },
            "openingSceneId": {
              "value": "scenes.1"
            }
          },
          "tags": [
            "waste-deep",
            "campaign-kit"
          ]
        }
      },
      {
        "op": "set",
        "path": "/content/templates/waste.deep.kit.seed-vault",
        "value": {
          "kind": "campaign-kit",
          "values": {
            "name": {
              "value": "Seed Vault: The Next Season"
            },
            "kitId": {
              "value": "kit.seed-vault"
            },
            "openingSceneId": {
              "value": "scenes.2"
            }
          },
          "tags": [
            "waste-deep",
            "campaign-kit"
          ]
        }
      },
      {
        "op": "set",
        "path": "/content/templates/waste.deep.kit.last-grid",
        "value": {
          "kind": "campaign-kit",
          "values": {
            "name": {
              "value": "Last Grid: Both Hearths Warm"
            },
            "kitId": {
              "value": "kit.last-grid"
            },
            "openingSceneId": {
              "value": "scenes.3"
            }
          },
          "tags": [
            "waste-deep",
            "campaign-kit"
          ]
        }
      },
      {
        "op": "merge",
        "path": "/content/templates/world.root/components",
        "value": {
          "deep-kit-dustroad-convoy": {
            "template": "waste.deep.kit.dustroad-convoy",
            "count": 1,
            "when": {
              "eq": [
                {
                  "descriptor": "world.campaignKit"
                },
                "kit.dustroad-convoy"
              ]
            }
          },
          "deep-kit-seed-vault": {
            "template": "waste.deep.kit.seed-vault",
            "count": 1,
            "when": {
              "eq": [
                {
                  "descriptor": "world.campaignKit"
                },
                "kit.seed-vault"
              ]
            }
          },
          "deep-kit-last-grid": {
            "template": "waste.deep.kit.last-grid",
            "count": 1,
            "when": {
              "eq": [
                {
                  "descriptor": "world.campaignKit"
                },
                "kit.last-grid"
              ]
            }
          }
        }
