  "fragment": {
    "id": "masterhost.asset.space.world-template",
    "version": "1.0.0",
    "name": "Three Sector Campaign Frames",
    "description": "Three Sector Campaign Frames for Voidwake Archipelago, Sunforge Hegemony, Nightglass Frontier. Three complete interstellar campaigns: rescue routes, contested quarantine and a predictive gate archive.",
    "provides": [
      "world:space-opera"
    ],
    "requires": [
      "setting:space-opera"
    ],
    "conflicts": [],
    "parameters": {},
    "patches": [
      {
        "op": "set",
        "path": "/content/templates/space.deep.kit.voidwake-archipelago",
        "value": {
          "kind": "campaign-kit",
          "values": {
            "name": {
              "value": "Voidwake: The Broken Relay"
            },
            "kitId": {
              "value": "kit.voidwake-archipelago"
            },
            "openingSceneId": {
              "value": "scenes.1"
            }
          },
          "tags": [
            "space-deep",
            "campaign-kit"
          ]
        }
      },
      {
        "op": "set",
        "path": "/content/templates/space.deep.kit.sunforge-hegemony",
        "value": {
          "kind": "campaign-kit",
          "values": {
            "name": {
              "value": "Sunforge: The Sealed Treaty"
            },
            "kitId": {
              "value": "kit.sunforge-hegemony"
            },
            "openingSceneId": {
              "value": "scenes.2"
            }
          },
          "tags": [
            "space-deep",
            "campaign-kit"
          ]
        }
      },
      {
        "op": "set",
        "path": "/content/templates/space.deep.kit.nightglass-frontier",
        "value": {
          "kind": "campaign-kit",
          "values": {
            "name": {
              "value": "Nightglass: Tomorrow Changed"
            },
            "kitId": {
              "value": "kit.nightglass-frontier"
            },
            "openingSceneId": {
              "value": "scenes.3"
            }
          },
          "tags": [
            "space-deep",
            "campaign-kit"
          ]
        }
      },
      {
        "op": "merge",
        "path": "/content/templates/world.root/components",
        "value": {
          "deep-kit-voidwake-archipelago": {
            "template": "space.deep.kit.voidwake-archipelago",
            "count": 1,
            "when": {
              "eq": [
                {
                  "descriptor": "world.campaignKit"
                },
                "kit.voidwake-archipelago"
              ]
            }
          },
          "deep-kit-sunforge-hegemony": {
            "template": "space.deep.kit.sunforge-hegemony",
            "count": 1,
            "when": {
              "eq": [
                {
                  "descriptor": "world.campaignKit"
                },
                "kit.sunforge-hegemony"
              ]
            }
          },
          "deep-kit-nightglass-frontier": {
            "template": "space.deep.kit.nightglass-frontier",
            "count": 1,
            "when": {
              "eq": [
                {
                  "descriptor": "world.campaignKit"
                },
                "kit.nightglass-frontier"
              ]
            }
          }
        }
      }
    ]
  }
}
